{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy Batch Files",
            "type": "shell",
            "command": "xcopy",
            "args": [
                "${workspaceFolder}\\*.bat",
                "${workspaceFolder}\\bin\\Debug\\net9.0-windows\\",
                "/Y"
            ],
            "options": {
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": ["/c"]
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false,
                "close": true
            },
            "problemMatcher": []
        }
    ]
}
